# ASP.NET Core Phasor API Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
PORT=5000

# Telemetry Streams
NOAA_PLASMA_URL=https://services.swpc.noaa.gov/products/solar-wind/plasma-5-minute.json
NOAA_MAG_URL=https://services.swpc.noaa.gov/products/solar-wind/mag-5-minute.json

# Internal Microservices Integration
PYTHON_ENGINE_URL=http://localhost:8000

# MongoDB Database Persistence (Atlas Cluster)
MONGODB_URI=mongodb+srv://ShawnMain:<password>@cluster0.yxk9mo6.mongodb.net/phasor?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=phasor

# Security & CORS
CORS_ALLOWED_ORIGINS=*
