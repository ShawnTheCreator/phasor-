# =============================================================================
# PHASOR / GRIDGUARD AFRICA — MULTI-HAZARD SADC SPACE WEATHER PLATFORM
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your keys.
# =============================================================================

ENVIRONMENT=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_URL=http://localhost:8000
DOTNET_API_URL=http://localhost:5000
DASHBOARD_URL=http://localhost:3000
HOME_URL=http://localhost:5173

# NASA & NOAA Real-Time Telemetry Feeds
NASA_API_KEY=DEMO_KEY
NOAA_SWPC_MAG_URL=https://services.swpc.noaa.gov/json/dscovr/dscovr_mag_1s.json
NOAA_SWPC_PLASMA_URL=https://services.swpc.noaa.gov/json/dscovr/dscovr_plasma_1m.json
NOAA_SWPC_ALERTS_URL=https://services.swpc.noaa.gov/products/alerts.json
KYOTO_WDC_DST_URL=https://wdc.kugi.kyoto-u.ac.jp/dst_realtime/

# SANSA Space Science Regional Warning Centre
SANSA_RWC_API_URL=https://spaceweather.sansa.org.za/api
SANSA_API_KEY=your_sansa_api_key_here

# Africa's Talking / Twilio SMS Dispatch
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_key
AFRICASTALKING_SENDER_ID=PHASOR_SADC
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
DEFAULT_DISPATCH_PHONE=+27825550192
DEFAULT_DISPATCH_EMAIL=dispatch@ntcc.eskom.co.za

# SADC & SAPP Grid Integration
SAPP_GATEWAY_URL=http://localhost:8000/api/grid/sapp
ESKOM_NTCC_FEED_URL=http://localhost:5000/api/risk/current
SADC_GRID_REGIONS=SA,NA,BW,ZW,MZ,ZM

# GNSS Scintillation Network
GNSS_SEPTENTRIO_RX_URL=http://localhost:8000/api/gnss/scintillation
GNSS_ALERT_THRESHOLD_S4_MODERATE=0.20
GNSS_ALERT_THRESHOLD_S4_SEVERE=0.50

# Aviation & ICAO Thresholds
ICAO_PRIMARY_FIRS=FAOR,FACT,FBGR,FVHF,FQBE,FLFI
ICAO_RAD_MODERATE_USV_H=30.0
ICAO_RAD_SEVERE_USV_H=80.0
ICAO_HF_ABSORPTION_MODERATE_DB=2.0
ICAO_HF_ABSORPTION_SEVERE_DB=5.0

# Space-Track Credentials
SPACE_TRACK_USER=your_spacetrack_username
SPACE_TRACK_PASSWORD=your_spacetrack_password

# MongoDB Database
MONGODB_URI=mongodb+srv://ShawnMain:<password>@cluster0.yxk9mo6.mongodb.net/phasor?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=phasor
MONGO_URI=mongodb+srv://ShawnMain:<password>@cluster0.yxk9mo6.mongodb.net/phasor?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=phasor

# Frontend Client Public Variables
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_DOTNET_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/grid
NEXT_PUBLIC_DEFAULT_ROLE=grid
